{
  "$id": "redteam-doctrine/verdict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "minLength": 1,
          "type": "string"
        },
        "runId": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "ci",
            "unknown"
          ]
        },
        "agentId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "app",
        "runId"
      ],
      "type": "object"
    },
    "attestation": {
      "type": "string"
    },
    "checks": {
      "additionalProperties": false,
      "properties": {
        "unresolvedSymbols": {
          "enum": [
            "measured",
            "unsupported",
            "notRun"
          ],
          "type": "string"
        },
        "unsupportedFiles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "unresolvedSymbols",
        "unsupportedFiles"
      ],
      "type": "object"
    },
    "counters": {
      "additionalProperties": false,
      "properties": {
        "deadCodeCandidates": {
          "minimum": 0,
          "type": "integer"
        },
        "encodedPayloadsFound": {
          "minimum": 0,
          "type": "integer"
        },
        "filesTouched": {
          "minimum": 0,
          "type": "integer"
        },
        "hiddenSpansRemoved": {
          "minimum": 0,
          "type": "integer"
        },
        "largestComponentEntities": {
          "minimum": 0,
          "type": "integer"
        },
        "layerContractViolations": {
          "minimum": 0,
          "type": "integer"
        },
        "netLocChanged": {
          "type": "integer"
        },
        "newDependencies": {
          "minimum": 0,
          "type": "integer"
        },
        "newPublicSymbols": {
          "minimum": 0,
          "type": "integer"
        },
        "newSmells": {
          "minimum": 0,
          "type": "integer"
        },
        "nonOwnerCommandAttempts": {
          "minimum": 0,
          "type": "integer"
        },
        "nondeterministicDiffLines": {
          "minimum": 0,
          "type": "integer"
        },
        "redundantCommentLines": {
          "minimum": 0,
          "type": "integer"
        },
        "responsibilityShifts": {
          "minimum": 0,
          "type": "integer"
        },
        "secretsFound": {
          "minimum": 0,
          "type": "integer"
        },
        "unmappedClaims": {
          "minimum": 0,
          "type": "integer"
        },
        "unresolvedSymbols": {
          "minimum": 0,
          "type": "integer"
        },
        "packagesTouched": {
          "type": "integer",
          "minimum": 0
        },
        "protectedPathHits": {
          "type": "integer",
          "minimum": 0
        },
        "largestFileAddedLines": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "netLocChanged",
        "filesTouched",
        "deadCodeCandidates",
        "newDependencies",
        "newPublicSymbols",
        "unresolvedSymbols",
        "newSmells",
        "responsibilityShifts",
        "largestComponentEntities",
        "layerContractViolations",
        "unmappedClaims",
        "redundantCommentLines",
        "secretsFound",
        "nondeterministicDiffLines",
        "hiddenSpansRemoved",
        "encodedPayloadsFound",
        "nonOwnerCommandAttempts",
        "packagesTouched",
        "protectedPathHits",
        "largestFileAddedLines"
      ],
      "type": "object"
    },
    "doctrineVersion": {
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "minLength": 1,
            "type": "string"
          },
          "file": {
            "minLength": 1,
            "type": "string"
          },
          "gate": {
            "minLength": 1,
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "gate",
          "file",
          "line",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "coreVersion": {
          "minLength": 1,
          "type": "string"
        },
        "policyHash": {
          "minLength": 8,
          "type": "string"
        },
        "policyVersion": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "policyVersion",
        "policyHash",
        "coreVersion"
      ],
      "type": "object"
    },
    "pr": {
      "additionalProperties": false,
      "properties": {
        "baseSha": {
          "minLength": 7,
          "type": "string"
        },
        "headSha": {
          "minLength": 7,
          "type": "string"
        }
      },
      "required": [
        "baseSha",
        "headSha"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "tests": {
      "additionalProperties": false,
      "properties": {
        "changedLinesCoveredPercent": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        "greenOnHead": {
          "type": "boolean"
        },
        "mutationSurvivorsSampled": {
          "minimum": 0,
          "type": "integer"
        },
        "redOnBase": {
          "type": "boolean"
        }
      },
      "required": [
        "redOnBase",
        "greenOnHead",
        "changedLinesCoveredPercent",
        "mutationSurvivorsSampled"
      ],
      "type": "object"
    },
    "verdict": {
      "enum": [
        "pass",
        "warn",
        "block"
      ]
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lane": {
          "type": "string",
          "enum": [
            "agent",
            "pr",
            "maintainer"
          ]
        },
        "maintainerReviewRequired": {
          "type": "boolean"
        },
        "selfMergeEligible": {
          "type": "boolean"
        },
        "triagePriority": {
          "type": "integer"
        }
      },
      "required": [
        "lane",
        "maintainerReviewRequired",
        "selfMergeEligible",
        "triagePriority"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "pr",
    "policy",
    "actor",
    "counters",
    "tests",
    "verdict",
    "findings",
    "routing"
  ],
  "title": "pr_redteam verdict",
  "type": "object"
}